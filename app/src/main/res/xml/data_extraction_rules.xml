<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ 云备份 / 设备迁移规则：
  天气缓存数据库（weather_cache.db）为 30 分钟级临时数据，无需备份迁移。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="weather_cache.db" />
        <exclude domain="database" path="weather_cache.db-wal" />
        <exclude domain="database" path="weather_cache.db-shm" />
        <exclude domain="database" path="weather_cache.db-journal" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="weather_cache.db" />
        <exclude domain="database" path="weather_cache.db-wal" />
        <exclude domain="database" path="weather_cache.db-shm" />
        <exclude domain="database" path="weather_cache.db-journal" />
    </device-transfer>
</data-extraction-rules>
