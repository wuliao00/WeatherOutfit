<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 网络访问：获取天气数据 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 定位：GPS 精确查询天气 -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- 通知：Android 13+ 需要运行时申请 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 开机自启：重启后对齐每日推送的 WorkManager 调度时刻 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!--
      应用内更新：Android 8+ 的「安装未知应用」是特殊权限（appops），不走 requestPermissions()——
      那条 API 对它永远返回 deny，写进代码只会让人以为申请过了。
      漏这一条的症状既不是编译失败也不是测试变红：PackageManager 没有这项能力时
      canRequestPackageInstalls() 恒 false ⇒ 用户拒绝/没被弹窗过一次就**永远停在权限引导页**，
      而门禁那一侧看起来完全正常（Task 4 的台账把这条登记成了 Task 8 的验收到场项）。
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".WeatherOutfitApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.WeatherOutfit">

        <!--
          preferMinimalPostProcessing（Android 12+）：请求合成器跳过本帧的
          后处理（圆角/色调映射等），把触摸到上屏的延迟压到最低，
          这是「动画跟手」里容易被忽略的一半——光有 120Hz 不够，还得让每一帧更早出现。
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:preferMinimalPostProcessing="true"
            android:theme="@style/Theme.WeatherOutfit">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 开机广播：仅系统可发送（受保护广播），exported=false 即可安全接收 -->
        <receiver
            android:name=".notification.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!--
          应用内下载的 APK 落在 cacheDir/update/ 下，要把它交给**另一个进程**（系统安装器）读，
          只能给 content:// URI：Android 7+ 把 file:// URI 交出去会抛 FileUriExposedException，
          表现是「下完了、点立即更新什么都没发生」，而异常只在 logcat 里。
          - authorities 用 ${applicationId}.fileprovider，AndroidUpdateGateway 里拼的那串必须逐字一致，
            对不上的症状是 getUriForFile 抛 IllegalArgumentException；
          - grantUriPermissions=true 才让 Intent 上的 FLAG_GRANT_READ_URI_PERMISSION 有意义
            （没有它安装器拿到 URI 也读不到文件）；
          - exported=false：不对外提供，只有被临时授权的那一次读取能进来。
          能暴露哪些目录不写在这里，写在 @xml/file_paths（只开 update 一层，不用 root-path）。
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
